modules = ["nodejs-24", "python-3.12", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "vm"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pick-ledger"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/moneyline run build && python -m pytest -q && pnpm --filter @workspace/moneyline run smoke"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "pick-ledger"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m pytest -q tests/test_pick_ledger.py tests/test_grade_pick.py tests/test_grade_pending_records.py"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["glibcLocales", "postgresql", "glib", "nss", "nspr", "atk", "at-spi2-atk", "cups", "libdrm", "dbus", "expat", "libxkbcommon", "pango", "cairo", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "xorg.libxshmfence", "mesa", "libgbm", "alsa-lib"]

[userenv]

[userenv.shared]

[objectStorage]
defaultBucketID = "replit-objstore-93c7e335-070b-4fe7-9ac1-6877cb07acfa"
